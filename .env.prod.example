# ─────────────────────────────────────────────────────────────
# Gafeso — Variables d'environnement de PRODUCTION
#
# Copier vers .env.prod SUR LE SERVEUR (jamais commité — voir .gitignore) :
#   cp .env.prod.example .env.prod
# Puis remplir CHAQUE valeur marquée « À REMPLIR ». Le déploiement refuse
# de démarrer si une variable requise manque (voir DEPLOY.md).
#
# Différent de .env.example (développement local, valeurs par défaut
# utilisables telles quelles) : ici, RIEN n'a de valeur par défaut faible —
# docker-compose.prod.yml échoue explicitement si une variable sensible
# n'est pas définie plutôt que de démarrer avec un secret prévisible.
# ─────────────────────────────────────────────────────────────

# ── Domaines (Caddy — HTTPS automatique via Let's Encrypt) ──
# Les trois DOIVENT pointer (DNS A/AAAA) vers l'IP de ce serveur AVANT le
# premier démarrage, sinon Caddy échoue à obtenir les certificats.
PUBLIC_DOMAIN=À REMPLIR   # ex. bibliotheque.gafeso.exemple — l'application
API_DOMAIN=À REMPLIR      # ex. api.bibliotheque.gafeso.exemple — API directe (Swagger, mobile futur)
STORAGE_DOMAIN=À REMPLIR  # ex. storage.bibliotheque.gafeso.exemple — couvertures publiques (MinIO)
ACME_EMAIL=À REMPLIR      # contact pour les certificats Let's Encrypt (alertes d'expiration)

# ── Application ──
APP_URL=https://À_REMPLIR_MEME_VALEUR_QUE_PUBLIC_DOMAIN
# Origines CORS : par défaut = APP_URL. Ajouter d'autres origines séparées
# par des virgules si nécessaire (ex. une appli mobile avec son propre domaine).
CORS_ORIGINS=

# ── Nom de projet Compose ──
# Préfixe les volumes, le réseau et les images. Sur une installation DÉJÀ en
# service, gardez la valeur existante (historiquement « bibliocloud-prod ») :
# la changer détacherait les volumes, donc les données. Pour renommer
# réellement, voir scripts/rename-to-gafeso.sh.
COMPOSE_PROJECT_NAME=gafeso-prod

# ── Base de données (PostgreSQL 16) ──
POSTGRES_USER=gafeso
POSTGRES_PASSWORD=À REMPLIR — générer : openssl rand -base64 32
POSTGRES_DB=gafeso

# ── Authentification (JWT) ──
JWT_SECRET=À REMPLIR — 32 caractères aléatoires minimum : openssl rand -base64 32
JWT_EXPIRES_IN=1d

# ── Plateforme / super-admin (provisioning des écoles, routes /admin/*) ──
ADMIN_API_KEY=À REMPLIR — 24 caractères aléatoires minimum : openssl rand -base64 24

# ── Moteur de recherche ──
# meilisearch (défaut recommandé, ~100 Mo) | elasticsearch (option, 2–4 Go de
# RAM — uniquement si vous réutilisez un ES existant ; voir docs/search-engines.md
# et DEPLOY.md « Choisir le moteur de recherche »). Absent → Meilisearch.
SEARCH_ENGINE=meilisearch

# ── Meilisearch (si SEARCH_ENGINE=meilisearch) ──
MEILI_MASTER_KEY=À REMPLIR — 32 caractères aléatoires minimum : openssl rand -base64 32

# ── Elasticsearch (UNIQUEMENT si SEARCH_ENGINE=elasticsearch) ──
# ELASTIC_NODE=http://elasticsearch:9200
# ELASTIC_USERNAME=        # si xpack.security activé
# ELASTIC_PASSWORD=

# ── MinIO (stockage S3) ──
MINIO_ROOT_USER=gafeso
MINIO_ROOT_PASSWORD=À REMPLIR — 16 caractères minimum : openssl rand -base64 24
# URL PUBLIQUE du bucket "covers" — doit correspondre à STORAGE_DOMAIN
# ci-dessus (Caddy y sert directement le trafic vers MinIO). Sans cette
# variable, les couvertures d'ouvrages généreraient des URLs internes
# ("http://minio:9000/...") injoignables depuis le navigateur.
MINIO_PUBLIC_URL=https://À_REMPLIR_MEME_VALEUR_QUE_STORAGE_DOMAIN

# ── Email (SMTP réel) ──
# Laissé vide : l'application démarre quand même et journalise les emails
# au lieu de les envoyer (aucun crash) — pratique pour un premier
# déploiement de test. À remplir avant la mise en service réelle : sans
# SMTP fonctionnel, personne ne reçoit son lien d'activation de mot de passe.
SMTP_HOST=
SMTP_PORT=587
# Vide = DÉDUIT DU PORT (465 → TLS implicite ; 587/25 → STARTTLS). C'est le
# bon réglage dans la quasi-totalité des cas. Ne forcez true/false que pour
# un serveur exotique : « true » sur le port 587 fait échouer la poignée de
# main, et aucun mail ne part alors que le port répond.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gafeso <no-reply@À_REMPLIR>"

# ── Cœur offline (module offline-licensing) — OBLIGATOIRE ──
# L'api REFUSE de démarrer si l'une des deux clés est absente ou malformée.
# À SAUVEGARDER avec les données : les perdre rend illisibles les contenus
# déjà chiffrés et invalide les licences déjà émises. Ne jamais les regénérer
# sur une installation en service.
#
# 1) KEK de contenu — 32 octets, base64 STANDARD (padding « = » compris) :
#      openssl rand -base64 32
OFFLINE_CONTENT_KEK=À REMPLIR — openssl rand -base64 32
# 2) Clé privée de signature de licence — Ed25519, PEM PKCS8. Un fichier
#    d'environnement ne gère pas le multiligne : coller le PEM sur UNE SEULE
#    ligne, retours à la ligne échappés en « \n », sans guillemets :
#      openssl genpkey -algorithm ed25519 | awk 'BEGIN{ORS="\\n"}1'
#    → OFFLINE_LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4C…\n-----END PRIVATE KEY-----\n  (gabarit, pas une clé — gitleaks:allow)
OFFLINE_LICENSE_PRIVATE_KEY=À REMPLIR — voir la commande ci-dessus
