// Gafeso — Prisma Schema (v2)
// Multi-tenant via PostgreSQL schemas
// public schema = shared (commercial catalog, federation, payments)
// tenant_<slug> schema = per-school (patrons, loans, local records, students)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// PUBLIC SCHEMA — Shared / Platform data
// ═══════════════════════════════════════════════════════════

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  status        TenantStatus    @default(ACTIVE)
  plan          TenantPlan      @default(STARTER)
  domains       Domain[]
  settings      TenantSettings?
  subscriptions Subscription[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("tenants")
}

model Domain {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  domain    String  @unique
  isPrimary Boolean @default(false) @map("is_primary")
  sslStatus String  @default("pending") @map("ssl_status")
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@map("domains")
}

model TenantSettings {
  id                         String  @id @default(uuid())
  tenantId                   String  @unique @map("tenant_id")
  /// Modules DÉSACTIVÉS pour cet établissement — P4-1.
  ///
  /// ⚠ ON STOCKE LES DÉSACTIVATIONS, PAS LES ACTIVATIONS. Absent = actif. La
  /// décision 8 du brief (« tout module est actif par défaut, une migration ne
  /// retire rien à personne ») devient vraie PAR CONSTRUCTION : une école
  /// existante n'a aucune ligne à écrire, et un module ajouté demain est actif
  /// partout sans migration. L'encodage inverse aurait exigé d'énumérer, pour
  /// chaque école, la liste des modules connus au moment de la migration — et
  /// un module ajouté ensuite serait né éteint chez tout le monde.
  ///
  /// ⚠ ET C'EST BIEN « PAR ÉTABLISSEMENT » (décision 7) malgré le schéma
  /// `public` : cette table est clé par `tenant_id`. Elle évite au passage le
  /// piège du `LIKE INCLUDING ALL` — il n'y a pas de table tenant à rattraper.
  modulesDesactives          Json    @default("[]") @map("modules_desactives")
  logoUrl                    String? @map("logo_url")
  primaryColor               String  @default("#0F2B46") @map("primary_color")
  secondaryColor             String  @default("#D97B2B") @map("secondary_color")
  locale                     String  @default("fr")
  timezone                   String  @default("Africa/Ouagadougou")
  currency                   String  @default("XOF")
  // Page d'accueil vitrine (spec docs/spec-accueil-tenant.md) — tout par
  // tenant, dans le schéma public (pas de sync-schema à propager).
  // themeTokens : tokens de couleur NEUTRES/support de la vitrine (fonds,
  //   surface, textes, highlight, danger, primary-dark, accent-soft). --primary
  //   et --accent NE sont PAS ici : partagés avec l'app (primaryColor /
  //   secondaryColor ci-dessus) — un seul choix de couleur par école.
  // latticeEnabled : motif décoratif (croisillons) activé pour cette école.
  // homepageContent : contenu éditable de la vitrine (identité, stats, espaces,
  //   services, horaires, ressources, contact) — voir home-content.ts.
  themeTokens                Json?   @map("theme_tokens")
  latticeEnabled             Boolean @default(false) @map("lattice_enabled")
  homepageContent            Json?   @map("homepage_content")
  // 2FA OBLIGATOIRE pour les rôles disposant de comptes.gerer / etablissement.gerer.
  // Schéma public (pas de sync-schema) → défaut non-null sans risque.
  require2fa                 Boolean @default(false) @map("require_2fa")
  // Rappels de circulation par email (moteur : reminders.service). Tout dans le
  // schéma public (pas de sync-schema). remindersEnabled : bascule globale.
  // reminderDaysBefore (N) : rappel d'échéance J-N. overdueRepeatDays (M) :
  // relance de retard à J+1 puis tous les M jours. reminderTemplates : sujet +
  // corps éditables par type ({ dueSoon: {subject, body}, overdue: {...} }) —
  // défauts FR appliqués à la lecture si null (reminder-templates.ts).
  remindersEnabled           Boolean @default(false) @map("reminders_enabled")
  reminderDaysBefore         Int     @default(2) @map("reminder_days_before")
  overdueRepeatDays          Int     @default(7) @map("overdue_repeat_days")
  reminderTemplates          Json?   @map("reminder_templates")
  // Politique de circulation en ligne (self-service lecteur). Schéma public →
  // pas de sync-schema. onlineRenewalEnabled : renouvellement en ligne autorisé.
  // onlineRenewalMax : plafond de renouvellements en ligne par prêt.
  // onlineRenewalDays : durée (jours) accordée à chaque renouvellement.
  // onlineRenewalRefuseOverdue : refuser si le prêt est déjà en retard.
  // holdPickupDays : durée de mise de côté d'une réservation disponible.
  onlineRenewalEnabled       Boolean @default(true) @map("online_renewal_enabled")
  onlineRenewalMax           Int     @default(2) @map("online_renewal_max")
  onlineRenewalDays          Int     @default(14) @map("online_renewal_days")
  onlineRenewalRefuseOverdue Boolean @default(true) @map("online_renewal_refuse_overdue")
  holdPickupDays             Int     @default(7) @map("hold_pickup_days")
  // Cœur offline : durée (jours) du bail de licence hors-ligne émis par l'école.
  // Schéma public → pas de sync-schema ; défaut non-null sans risque.
  offlineLicenseTtlDays      Int     @default(14) @map("offline_license_ttl_days")
  // Échéance des prêts : HEURE fixe (HH:MM) dans le FUSEAU de l'établissement.
  // Réglable et non figé : une constante juste pour une école redevient fausse
  // pour la suivante — c'est ce qui s'était produit avec l'année académique.
  loanDueTime                String  @default("16:00") @map("loan_due_time")
  tenant                     Tenant  @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

// Journal des rappels de circulation envoyés — schéma PUBLIC (comme audit_logs).
// Volontairement hors des schémas tenant : (1) table de log dénormalisée
// (destinataire, titre, code-barres, échéance figés à l'envoi) → l'écran admin
// se lit sans jointure inter-schéma ; (2) `checkoutId`/`tenantId` sont des UUID
// globalement uniques → pas de FK (même parti pris que audit_logs). L'unicité
// (checkoutId, type, stageKey) est la garantie d'IDEMPOTENCE : un même rappel
// ne peut être journalisé (donc envoyé) qu'une fois. Statut : PENDING (réservé
// avant envoi, anti-double-envoi inter-instances), SENT (terminal),
// FAILED / SKIPPED_NO_EMAIL (retentés au prochain passage).
model ReminderLog {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  checkoutId     String    @map("checkout_id")
  type           String // DUE_SOON | OVERDUE
  stageKey       String    @map("stage_key") // discriminant d'idempotence (date d'échéance / n° de relance)
  recipientEmail String?   @map("recipient_email")
  recipientName  String?   @map("recipient_name")
  itemBarcode    String?   @map("item_barcode")
  recordTitle    String?   @map("record_title")
  dueDate        DateTime? @map("due_date")
  status         String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED_NO_EMAIL
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([checkoutId, type, stageKey])
  @@index([tenantId, createdAt])
  @@map("reminder_logs")
}

// ── Commercial catalog (paid books, shared across schools) ──

model CommercialTitle {
  id          String            @id @default(uuid())
  title       String
  author      String
  isbn        String?
  publisherId String?           @map("publisher_id")
  coverUrl    String?           @map("cover_url")
  description String?
  language    String            @default("fr")
  priceXof    Int               @map("price_xof") // purchase price in FCFA
  fileFormat  String            @map("file_format") // pdf, epub
  fileUrl     String            @map("file_url") // encrypted master file
  publisher   Publisher?        @relation(fields: [publisherId], references: [id])
  collections CollectionTitle[]
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([title])
  @@index([isbn])
  @@map("commercial_titles")
}

model Publisher {
  id           String            @id @default(uuid())
  name         String
  contactEmail String?           @map("contact_email")
  revenueShare Float             @default(0.7) @map("revenue_share") // 70% to publisher
  titles       CommercialTitle[]
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("publishers")
}

// ── External library (federated catalogs) ──

model ExternalLibrary {
  id           String    @id @default(uuid())
  name         String // "Bibliothèque Nationale du Burkina"
  protocol     String // "OAI-PMH", "Z39.50", "SRU"
  endpointUrl  String    @map("endpoint_url")
  contactEmail String?   @map("contact_email")
  status       String    @default("active")
  lastHarvest  DateTime? @map("last_harvest")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("external_libraries")
}

// ── Collections (groups of resources with access rules) ──
// A collection can hold commercial titles AND/OR external resources.
// Access is granted to classes / subscription tiers.

/// ⚠ HIÉRARCHIE (P6-1, 12 septembre 2026) — Faculté → Département → Type.
///
/// `parentId` est FACULTATIF : toutes les collections existantes restent des
/// racines, aucune ne bouge, rien ne se perd.
///
/// Deux propriétés sont garanties EN BASE par un trigger, pas par la seule
/// validation applicative — voir la migration `collections_hierarchie` et
/// `src/collections/hierarchie.ts` :
///  · profondeur maximale de 3 niveaux ;
///  · aucun cycle (une collection n'est jamais son propre ancêtre).
model Collection {
  id          String            @id @default(uuid())
  name        String // "Ressources Droit L1", "Abonnement Médecine 2026"
  description String?
  type        CollectionType    @default(INTERNAL)
  sourceId    String?           @map("source_id") // external library id or subscription id
  // Propriétaire pour les collections INTERNAL (ressources numérisées propres
  // à une école, voir CollectionTitle.recordId) : null pour les collections
  // partagées (COMMERCIAL/EXTERNAL), fixé au premier document ajouté sinon.
  tenantId    String?           @map("tenant_id")
  // Collection SOCLE créée au provisioning de l'école : elle reçoit
  // automatiquement les documents numérisés, et porte la règle d'accès par
  // défaut. Une école n'en a qu'une (index unique partiel côté migration).
  // ⚠ MODIFIABLE, MAIS PAS SUPPRIMABLE — et la ligne disait le contraire
  // jusqu'au 12 septembre 2026, sans jamais avoir été vraie : AUCUNE collection
  // ne se supprimait alors. `DigitalCopyService` rattache chaque document
  // numérisé au socle et sort EN SILENCE s'il n'y en a pas ; sans socle, un
  // document téléversé n'entre dans aucune collection et n'est visible de
  // personne, sans erreur ni trace.
  isDefault   Boolean           @default(false) @map("is_default")
  /// Collection parente, ou `null` pour une racine. Auto-relation.
  parentId    String?           @map("parent_id")
  parent      Collection?       @relation("HierarchieCollections", fields: [parentId], references: [id])
  children    Collection[]      @relation("HierarchieCollections")
  titles      CollectionTitle[]
  accessRules AccessRule[]
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([parentId])
  @@map("collections")
}

// Un item de collection référence SOIT un titre du catalogue commercial
// (titleId, schéma public), SOIT un BiblioRecord numérisé localement par une
// école (recordId — simple identifiant, pas de FK : BiblioRecord vit dans le
// schéma tenant_<slug>, hors de portée d'une relation Prisma depuis le schéma
// public). Exactement l'un des deux doit être renseigné (appliqué en code).
model CollectionTitle {
  id           String           @id @default(uuid())
  collectionId String           @map("collection_id")
  titleId      String?          @map("title_id")
  recordId     String?          @map("record_id")
  collection   Collection       @relation(fields: [collectionId], references: [id])
  title        CommercialTitle? @relation(fields: [titleId], references: [id])

  @@unique([collectionId, titleId])
  @@unique([collectionId, recordId])
  @@index([recordId])
  @@map("collection_titles")
}

// AccessRule: who can access a collection.
// Matches on tenant + class/level + subscription tier.
model AccessRule {
  id               String     @id @default(uuid())
  collectionId     String     @map("collection_id")
  tenantId         String     @map("tenant_id") // which school
  className        String?    @map("class_name") // "L1_DROIT", null = all classes
  subscriptionTier String?    @map("subscription_tier") // "premium", null = any tier
  collection       Collection @relation(fields: [collectionId], references: [id])

  @@index([tenantId, className])
  @@map("access_rules")
}

enum CollectionType {
  INTERNAL // school's own digitized resources
  COMMERCIAL // paid titles from commercial catalog
  EXTERNAL // from a federated external library
}

// ── Subscriptions (school pays for external collections) ──

model Subscription {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  collectionId String?   @map("collection_id") // the unlocked collection
  name         String // "Abonnement Médecine 2026"
  priceXof     Int       @map("price_xof")
  billingCycle String    @default("yearly") @map("billing_cycle") // monthly, yearly
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  status       String    @default("active")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  payments     Payment[]

  @@map("subscriptions")
}

// ── Payments (mobile money first) ──

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String?       @map("subscription_id")
  tenantId       String?       @map("tenant_id")
  amountXof      Int           @map("amount_xof")
  provider       String // "orange_money", "wave", "mtn_momo", "card"
  providerRef    String?       @map("provider_ref") // transaction id from provider
  status         PaymentStatus @default(PENDING)
  purpose        String // "subscription", "title_purchase"
  metadata       Json?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("super_admins")
}

// Journal d'audit des actions sensibles. Vit dans le schéma PUBLIC (pas
// tenant_<slug>) — décision volontaire :
//  - les actions PLATEFORME (endpoints super-admin par clé API, provisioning)
//    n'ont AUCUN schéma tenant → il leur faut un domicile commun ;
//  - une connexion ÉCHOUÉE peut précéder toute résolution de compte ;
//  - une seule surface de consultation, filtrée par tenantId (comme les
//    collections d'access-control, déjà en public + filtrage applicatif) ;
//  - AUCUN sync-schema à propager (contrairement à une table tenant) — une
//    simple migration suffit (voir DEPLOY.md).
// tenantId nullable : renseigné pour les actions d'une école, null pour les
// actions plateforme. Colonne simple (pas de FK) : le journal est append-only
// et ne doit jamais coupler son écriture à l'existence du tenant.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  // Acteur DÉNORMALISÉ : survit à la suppression du compte, et couvre les
  // connexions échouées (email inconnu → pas d'actorId).
  actorId     String?  @map("actor_id")
  actorEmail  String?  @map("actor_email")
  actorRole   String?  @map("actor_role")
  action      String // ex. auth.login.success, role.update, account.delete
  targetType  String?  @map("target_type") // user | role | record | category | homepage | tenant
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label") // libellé lisible (email supprimé, nom du rôle…)
  ip          String?
  metadata    Json? // contexte additionnel (ancien/nouveau, fonctions, raison d'échec…)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, actorId])
  @@map("audit_logs")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum TenantPlan {
  STARTER
  PRO
  UNIVERSITY
  ON_PREMISE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ═══════════════════════════════════════════════════════════
// TENANT SCHEMA — Per-school data (tenant_<slug>)
// ═══════════════════════════════════════════════════════════

// ── Expected students (pre-loaded list for auto-activation) ──
// Imported from the school's CSV/Excel. If a student registers with a
// matching matricule + email, their account is auto-activated.

model ExpectedStudent {
  id         String   @id @default(uuid())
  matricule  String   @unique
  email      String
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  className  String   @map("class_name") // "L1_DROIT", "M2_MEDECINE"
  claimed    Boolean  @default(false) // true once an account is created
  importedAt DateTime @default(now()) @map("imported_at")

  @@index([email])
  @@map("expected_students")
}

// ── User accounts ──

// Rôles dynamiques par école : chaque rôle porte une liste de fonctions
// (catalogue dans src/auth/functions.ts). Les rôles système (Étudiant,
// Bibliothécaire, Gestionnaire, Acquisitions, Administrateur) sont seedés
// et non modifiables/supprimables ; l'école peut créer les siens. Quand
// users.role_id est null, les fonctions viennent du repli historique sur
// l'enum users.role (voir AuthzService).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  functions   String[]
  isSystem    Boolean  @default(false) @map("is_system")
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  matricule        String?          @unique // for students
  password         String? // null until student sets it via secure link
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  role             UserRole         @default(STUDENT)
  roleId           String?          @map("role_id") // rôle dynamique (prioritaire sur l'enum)
  customRole       Role?            @relation(fields: [roleId], references: [id])
  status           AccountStatus    @default(PENDING)
  className        String?          @map("class_name") // student's current class
  subscriptionTier String           @default("free") @map("subscription_tier")
  passwordTokens   PasswordToken[]
  patron           Patron?
  /// Fiche d'autorité de cette personne, si elle en a une (P6-1).
  authorFiche      Author?
  enrollments      Enrollment[]
  devices          Device[]
  offlineLicenses  OfflineLicense[]
  createdAt        DateTime         @default(now()) @map("created_at")
  activatedAt      DateTime?        @map("activated_at")

  // Double authentification (2FA). Colonnes TOUTES nullables : la table `users`
  // vit dans chaque schéma tenant, et le rattrapage sync-schema ajoute les
  // colonnes en NULLABLE sans défaut (buildAddMissingColumnsStatements) — un
  // Int/booléen NON NULL casserait la lecture Prisma des lignes existantes.
  totpSecret        String?   @map("totp_secret") // secret TOTP base32 (posé au setup)
  totpEnabledAt     DateTime? @map("totp_enabled_at") // 2FA active si non null
  totpLastStep      Int?      @map("totp_last_step") // anti-rejeu : dernier pas de temps accepté
  backupCodes       Json?     @map("backup_codes") // tableau de hachages de codes de secours (usage unique)
  emailOtpHash      String?   @map("email_otp_hash") // repli OTP par email (haché)
  emailOtpExpiresAt DateTime? @map("email_otp_expires_at")
  emailOtpAttempts  Int?      @map("email_otp_attempts") // tentatives sur l'OTP email courant

  @@index([status])
  @@index([className])
  @@map("users")
}

// ── Enrollment (classes, niveaux, inscriptions) ──

model SchoolClass {
  id          String       @id @default(uuid())
  name        String       @unique // "L1_DROIT" — référencé par users.class_name / access_rules
  label       String? // "Licence 1 Droit"
  level       String? // "L1", "M2"...
  enrollments Enrollment[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("school_classes")
}

// Une inscription par étudiant et par année académique ; la classe active
// est reflétée dans users.class_name (utilisé par access-control).
model Enrollment {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  classId      String      @map("class_id")
  academicYear String      @map("academic_year") // "2026-2027"
  enrolledAt   DateTime    @default(now()) @map("enrolled_at")
  user         User        @relation(fields: [userId], references: [id])
  schoolClass  SchoolClass @relation(fields: [classId], references: [id])

  @@unique([userId, academicYear])
  @@index([classId, academicYear])
  @@map("enrollments")
}

// Secure token for "set your password" email link (24h expiry)
model PasswordToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_tokens")
}

enum UserRole {
  STUDENT
  LIBRARIAN // catalogs, circulation
  MANAGER // activates accounts, manages students
  ACQUISITIONS
  ADMIN // school admin
}

enum AccountStatus {
  PENDING // awaiting manual activation by a manager
  ACTIVE // can log in
  SUSPENDED
  EXPIRED
}

// ── Cataloging (local records) ──

// Catégories (domaines) du catalogue d'une école — alimente la liste
// déroulante de saisie des notices et regroupe la page constellation
// (OpacService.constellation, facette Meilisearch exacte). `name` est
// normalisé (espaces réduits, minuscules) à la création/au renommage : c'est
// la même valeur qui est stockée sur `BiblioRecord.category` (pas de clé
// étrangère — comparaison par chaîne, comme `users.class_name`/`SchoolClass`).
// Remplace la saisie libre, source de doublons dans la constellation
// (medecine / Medecine / médecine considérés comme 3 domaines distincts).
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model BiblioRecord {
  // ⚠ IDENTIFIANT IMMUABLE — voir docs/architecture-notice.md. Cet uuid est le
  // `docId` inscrit dans les licences hors-ligne SIGNÉES déployées sur les
  // téléphones : le changer invaliderait des licences déjà émises, hors de
  // portée du serveur. Aucune phase d'architecture ne le régénère, ne le
  // renumérote, ni ne le remplace par un identifiant « métier ».
  id                String              @id @default(uuid())
  // Métadonnées natives (couche 3) : le MARC d'origine, conservé BRUT, tel
  // qu'il est arrivé par import. NULL pour une notice saisie dans Gafeso —
  // elle n'a jamais eu de source MARC, et `{ fields: [] }` la faisait passer
  // pour une notice MARC vide. Ce n'est PAS ce que lit l'application : voir
  // `marcFormat` et docs/architecture-notice.md.
  marcData          Json?               @map("marc_data")
  // Format NATIF de la notice — d'où viennent ses métadonnées, pas comment on
  // les réexpose. `GAFESO` = notice Gafeso, le modèle plat propriétaire décrit
  // par les colonnes ci-dessous ; MARC21/UNIMARC = notice importée, dont
  // `marcData` garde l'original.
  marcFormat        MarcFormat          @default(UNIMARC) @map("marc_format")
  // Profil de description (couche 2) : quelles cases la notice a le droit de
  // remplir et selon quel écran de saisie. `bibliographique` (fonds classique)
  // ou `academique` (thèses, mémoires, rapports) — valeurs dans
  // cataloging/description-profiles.ts. String et NON enum Postgres, même
  // idiome que `recordType` : extensible sans migration, et le sync-schema
  // tenant ne rattrape pas les colonnes enum (tenant-schema.ts,
  // buildAddMissingColumnsStatements). Ne pilote encore AUCUN comportement —
  // posé maintenant pour ne pas migrer deux fois la table des notices.
  profile           String              @default("bibliographique")
  // Champs PROPRES au profil (couche 2) — P3-3, temps 1.
  //
  // ⚠ POURQUOI UNE COLONNE JSON ET NON DES COLONNES. L'invariant I2 dit que le
  // noyau ne grossit jamais. Chaque champ de profil ajouté en colonne le fait
  // grossir, et coûte une migration multi-établissements. Ici, un profil
  // nouveau (`archives`, `iconographique`) n'en coûte aucune.
  //
  // ⚠ CE QU'ELLE NE CHANGE PAS. Sortir un champ du noyau ne le retire PAS de
  // la recherche : `defenseUniversity` reste un attribut cherchable pondéré
  // (SEARCHABLE_ATTRIBUTES), et le document d'indexation continue de le porter
  // AU PREMIER NIVEAU, avec la même valeur. C'est ce qui rend la réindexation
  // NON DUE — mesuré avant le lot, pas supposé.
  //
  // ⚠ TEMPS 1 D'UN LOT EN DEUX TEMPS. Les trois colonnes
  // (`publication_city`, `defense_university`, `defense_place`) RESTENT, et les
  // écritures alimentent les deux endroits. Les lectures passent par ici. Le
  // temps 2 retirera les colonnes — et lui seul est irréversible, ce qui est la
  // raison du découpage : 61 points de code à reprendre, un consommateur
  // manqué doit pouvoir être rattrapé.
  profileData       Json                @default("{}") @map("profile_data")
  recordType        String              @map("record_type")
  title             String
  // Complément / sous-titre (cahier des charges fiche de saisie §2.1). Affiché
  // « Titre : complément » — le séparateur relève de l'AFFICHAGE, jamais stocké.
  titleComplement   String?             @map("title_complement")
  author            String?
  isbn              String?
  publishYear       Int?                @map("publish_year")
  language          String              @default("fr")
  publisher         String? // éditeur — extrait des métadonnées PDF/EPUB (brique 2) ou saisi manuellement
  // Publication / soutenance (cahier fiche de saisie §2.3) — tous nullables.
  // Ville d'édition SÉPARÉE de l'éditeur (jamais concaténés) ; champs de
  // soutenance pertinents pour Thèse/Mémoire seulement (affichage
  // conditionnel §3) ; l'année de soutenance réutilise publishYear (champ
  // année générique existant, libellé conditionnel côté formulaire).
  publicationCity   String?             @map("publication_city")
  defenseUniversity String?             @map("defense_university")
  defensePlace      String?             @map("defense_place")
  /// ⚠ EMBARGO (P6-4) — date de LEVÉE, jamais un drapeau.
  ///
  /// Un booléen « sous embargo » exigerait que quelqu'un pense à le baisser, et
  /// « un embargo qu'il faut penser à lever ne se lève jamais ». Une DATE se
  /// lève toute seule : la décision COMPARE, elle ne consulte pas un état.
  /// Aucune tâche planifiée, donc rien qui puisse ne pas tourner.
  ///
  /// ⚠ ET CE SONT LES MÉTADONNÉES QUI RESTENT VISIBLES, PAS LE FICHIER. Cacher
  /// la notice entière rendrait la thèse introuvable — or l'intérêt du dépôt
  /// est précisément qu'elle soit CITABLE pendant son embargo, et c'est ce que
  /// DICAMES moissonne.
  embargoUntil      DateTime?           @map("embargo_until")
  summary           String? // résumé/description — §3, tous types
  coverUrl          String?             @map("cover_url")
  category          String? // maps to constellation domain: "droit", "medecine"...
  items             Item[]
  holds             Hold[]
  digitalCopy       DigitalCopy?
  offlineLicenses   OfflineLicense[]
  contributors      RecordContributor[]
  keywords          RecordKeyword[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([title])
  @@index([category])
  @@map("biblio_records")
}

// Mots-clés (cahier fiche de saisie §2.4) : table dédiée + liaison n-n plutôt
// qu'un tableau de chaînes — permet l'autocomplétion et la réutilisation
// entre fiches du tenant (option « recommandée » du cahier). Noms normalisés
// comme les catégories (minuscules, espaces réduits). Règle des 3 minimum
// appliquée côté service (non rétroactive — décision §0).
model Keyword {
  id      String          @id @default(uuid())
  name    String          @unique
  records RecordKeyword[]

  @@map("keywords")
}

model RecordKeyword {
  recordId  String       @map("record_id")
  keywordId String       @map("keyword_id")
  record    BiblioRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  keyword   Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([recordId, keywordId])
  @@map("record_keywords")
}

// Contributeur d'une notice, avec rôle (cahier fiche de saisie §2.2) :
// plusieurs contributeurs par fiche, ≥1 AUTEUR_PRINCIPAL exigé côté serveur.
// Le rôle est un String validé applicativement (CONTRIBUTOR_ROLES,
// cataloging/contributor-roles.ts) et PAS un enum Postgres — même idiome que
// recordType : extensible sans migration (« traducteur », « préfacier »…
// annoncés), et le sync-schema tenant ne rattrape pas les colonnes enum.
// Pendant la transition, biblio_records.author reste alimenté avec le nom du
// premier auteur principal (suppression prévue dans une migration ultérieure).
model RecordContributor {
  id       String       @id @default(uuid())
  recordId String       @map("record_id")
  name     String
  role     String // AUTEUR_PRINCIPAL | AUTEUR_SECONDAIRE | DIRECTEUR_MEMOIRE
  position Int          @default(0) // tri d'affichage
  // Lien vers la fiche d'autorité (fichier d'autorités, à la PMB). NULLable :
  // `name` reste dénormalisé (une contribution s'affiche même sans lien). FK
  // RESTRICT → un auteur rattaché à des œuvres ne peut pas être supprimé.
  authorId String?      @map("author_id")
  record   BiblioRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // onDelete EXPLICITE. Sans lui, Prisma déduit `SetNull` pour une relation
  // optionnelle — or l'historique de migrations, le rattrapage tenant
  // (TENANT_FOREIGN_KEYS) et le commentaire ci-dessus disent tous RESTRICT.
  // Trois sources sur quatre disaient la même chose ; celle que lit un
  // développeur était la quatrième. Écrire la règle ici la rend vraie partout.
  author   Author?      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([recordId])
  @@index([authorId])
  @@map("record_contributors")
}

// Fiche d'autorité auteur (fichier d'autorités, sur le modèle de l'index
// Autorités de PMB — demande directrice BUC 2026-07-17). Propre à chaque école
// (schéma tenant). `normalizedName` = clé de déduplication (minuscule, sans
// accents, espaces réduits) : l'autocomplétion et la migration s'y appuient
// pour éviter les doublons. Index (pas unique) : les homonymes restent
// possibles, l'app guide la réutilisation et la fusion nettoie les doublons.
/// LE DÉPÔT — P6-2, 12 septembre 2026. Table TENANT (elle porte l'identité
/// d'un étudiant et son fichier).
///
/// ⚠ POURQUOI UNE TABLE DISTINCTE ET NON UN ÉTAT SUR `BiblioRecord`. Mesuré
/// avant de trancher : un état sur la notice demandait de reprendre 31 sites de
/// lecture dont 14 PUBLICS, et un seul oublié faisait sortir un dépôt non
/// validé en OPAC ou dans l'entrepôt OAI — où un moissonneur l'archive.
///
/// ⚠ ET SURTOUT L'INVARIANT I1. `BiblioRecord.id` ne change JAMAIS : c'est le
/// `docId` inscrit dans les licences hors-ligne signées déjà déployées sur des
/// téléphones. Avec un état sur la notice, un dépôt REFUSÉ laisserait un
/// identifiant mort-né dans la table même que ces licences indexent. Ici
/// l'identifiant de notice naît à la CATALOGATION, donc après toute hésitation.
///
/// ## Les quatre états, et ce que `recordId` n'est PAS
///
/// `brouillon` → `soumis` → `valide` | `refuse`. Le directeur valide le
/// CONTENU ; la notice, elle, est créée par le BIBLIOTHÉCAIRE à l'étape de
/// complétion (décision du 12 septembre : un étudiant n'a pas à fournir trois
/// mots-clés, c'est du catalogage et il les choisirait mal).
///
/// ⚠ `recordId` N'EST DONC PAS UN CINQUIÈME ÉTAT, c'est un RÉSULTAT. « Le
/// directeur a-t-il validé ? » et « la notice existe-t-elle ? » sont deux
/// questions sur deux axes : les confondre dans un seul enum obligerait à
/// inventer `valide_non_catalogue`, et le jour où le catalogage se défait
/// l'enum mentirait. Le prédicat « en attente de catalogage » est nommé une
/// seule fois, dans `depots/etats.ts`.
///
/// ⚠ AUCUNE DONNÉE N'EST SUPPRIMÉE par un refus : le dépôt reste, avec son
/// motif et son fichier.
model Deposit {
  id     String @id @default(uuid())
  /// `brouillon` | `soumis` | `valide` | `refuse`. TEXTE et non enum Postgres :
  /// c'est la convention des tables tenant (voir TENANT_TABLES), un enum devant
  /// être recréé dans chaque schéma d'école.
  status String @default("brouillon")

  /// ⚠ LE DÉPOSANT EST DISTINCT DE L'AUTEUR, dès le départ (décision 4 du
  /// brief). Un secrétariat qui dépose pour un étudiant, une thèse à deux
  /// auteurs : le jour où ça arrive, la colonne est là. Elle ne coûte rien
  /// aujourd'hui et ne se rattrape pas après cinq cents dépôts.
  depositorId String @map("depositor_id")
  authorName  String @map("author_name")

  /// Le directeur qui doit valider — un COMPTE, pas un nom. C'est
  /// `Author.userId` (P6-1) qui rend ce lien possible.
  directorId String? @map("director_id")

  title String
  year  Int?

  /// ⚠ TYPE et VERSION dès le départ, même si un seul type sert au début.
  /// « Cinq cents documents déposés sans savoir lesquels sont diffusables,
  /// c'est un fonds qu'on ne peut pas ouvrir. »
  documentType    String @map("document_type")
  documentVersion String @default("version_soutenue") @map("document_version")

  /// ── LE FICHIER DÉPOSÉ ────────────────────────────────────────────────────
  ///
  /// ⚠ IL EST CHIFFRÉ DÈS LE DÉPÔT, PAS AU CATALOGAGE. Décision du 12 septembre
  /// 2026, et le motif est le pire cas : un dépôt REFUSÉ que personne ne
  /// cataloguera jamais laisserait son fichier en clair indéfiniment. Les
  /// documents les moins protégés seraient exactement ceux que personne ne
  /// surveille — et une thèse sous embargo attend parfois des semaines une
  /// décision qui ne vient pas.
  ///
  /// ⚠ ET LE RATTACHEMENT À LA NOTICE NE RE-CHIFFRE NI NE RECOPIE RIEN.
  /// Vérifié avant d'écrire : `objectKey` et `encObjectKey` ne sont JAMAIS
  /// découpés dans `apps/api` — aucun `split`, `slice`, `startsWith` ni `match`.
  /// Le `recordId` dans le préfixe d'une clé est un groupement LISIBLE dans le
  /// seau, pas une donnée. Les clés d'un dépôt sont donc préfixées par son
  /// identifiant à lui, et le catalogage ne fait que COPIER ces valeurs de
  /// colonnes dans `digital_copies`. Le blob et la CEK enveloppée ne sont pas
  /// touchés — la CEK est enveloppée par la KEK SERVEUR, qui ne dépend d'aucune
  /// notice.
  fileKey    String? @map("file_key")
  fileName   String? @map("file_name")
  fileSize   Int?    @map("file_size")
  /// ⚠ TEXTE et non l'enum `DigitalFormat`, par cohérence avec `status` et
  /// pour une raison mécanique : un type enum doit être RECRÉÉ dans chaque
  /// schéma tenant, et le rattrapage de colonnes de `sync-schema` EXCLUT
  /// justement les colonnes enum. Une école existante ne recevrait donc pas
  /// cette colonne par le chemin normal. La valeur est validée en code contre
  /// le même vocabulaire (`PDF` | `EPUB`), et convertie à la création de la
  /// `DigitalCopy`, qui porte l'enum, elle.
  fileFormat String? @map("file_format")

  /// Résultat de l'ingestion chiffrée — mêmes colonnes que `DigitalCopy`, qui
  /// les recevra telles quelles au catalogage.
  encObjectKey    String?   @map("enc_object_key")
  encWrappedCek   String?   @map("enc_wrapped_cek")
  encSegSize      Int?      @map("enc_seg_size")
  encAlgo         String?   @map("enc_algo")
  encStatus       String?   @map("enc_status")
  encError        String?   @map("enc_error")
  xrefValidatedAt DateTime? @map("xref_validated_at")
  encryptedAt     DateTime? @map("encrypted_at")

  /// La notice, si elle existe. Voir l'en-tête : c'est un RÉSULTAT, pas un état.
  recordId String? @map("record_id")

  /// Motif du refus, JAMAIS effacé (décision 6).
  refusalReason String? @map("refusal_reason")

  /// ⚠ LE DIRECTEUR DÉJÀ PRÉVENU D'UNE SOUMISSION — un état d'ENVOI, pas un lien.
  ///
  /// La règle : on ne prévient QUE si `notifiedDirectorId !== directorId`. Une
  /// resoumission après retrait n'est pas une information nouvelle pour lui — le
  /// dépôt est toujours dans sa liste — sauf si le directeur a CHANGÉ entre les
  /// deux, seul cas où le nouveau n'a jamais rien reçu.
  ///
  /// ⚠ Pas de relation déclarée vers `User` : une clé étrangère ferait dépendre
  /// l'historique des envois de la survie du compte, et supprimer un enseignant
  /// rejouerait des courriels déjà partis.
  ///
  /// ⚠ Renseigné SEULEMENT si l'envoi a abouti : marquer « prévenu » sur un
  /// échec le rendrait muet pour toujours.
  notifiedDirectorId String? @map("notified_director_id")

  submittedAt DateTime? @map("submitted_at")
  decidedAt   DateTime? @map("decided_at")
  decidedById String?   @map("decided_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([depositorId])
  @@index([directorId, status])
  @@map("deposits")
}

/// ⚠ `userId` LIE UNE FICHE D'AUTORITÉ À UN COMPTE (P6-1, 12 septembre 2026).
///
/// Sans lui, « les mémoires et thèses que J'AI dirigés » n'est pas calculable :
/// la seule jointure disponible serait le NOM, c'est-à-dire précisément ce que
/// le fichier d'autorités existe pour éviter — et les noms divergent EXPRÈS
/// dans ce produit (une bibliothécaire corrige un nom d'épouse, une
/// orthographe).
///
/// ⚠ FACULTATIF DES DEUX CÔTÉS, et c'est une décision, pas un oubli. Un auteur
/// n'a pas forcément de compte — la plupart des auteurs d'un fonds n'en auront
/// jamais — et un compte n'est pas forcément un auteur. `@unique` borne la
/// relation à un pour un : un compte ne se rattache qu'à une seule fiche.
///
/// Il porte la phase P6 entière, pas un écran : sans lui, le circuit de dépôt
/// ne peut ni notifier le bon directeur, ni le reconnaître à la validation.
model Author {
  id             String              @id @default(uuid())
  displayName    String              @map("display_name")
  normalizedName String              @map("normalized_name")
  bio            String?
  birthYear      Int?                @map("birth_year")
  deathYear      Int?                @map("death_year")
  /// Compte de cette personne, si elle en a un. Voir l'en-tête du modèle.
  userId         String?             @unique @map("user_id")
  user           User?               @relation(fields: [userId], references: [id])
  contributions  RecordContributor[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([normalizedName])
  @@index([displayName])
  @@map("authors")
}

// Fichier numérique (PDF/EPUB) rattaché à une notice — stocké dans MinIO.
// Un seul exemplaire numérique par notice pour l'instant (1↔1).
// Phase 2 SANS DRM : le fichier stocké est en clair côté objet ; l'accès en
// lecture passe par une URL signée temporaire (voir storage.service.ts) et,
// à la brique 4, par access-control. Le chiffrement Readium LCP est Phase 3.
model DigitalCopy {
  id            String        @id @default(uuid())
  recordId      String        @unique @map("record_id")
  objectKey     String        @map("object_key") // chemin dans le bucket MinIO (fichier CLAIR, lecture en ligne)
  fileFormat    DigitalFormat @map("file_format")
  fileSizeBytes Int           @map("file_size_bytes")
  originalName  String        @map("original_name")
  uploadedAt    DateTime      @default(now()) @map("uploaded_at")
  record        BiblioRecord  @relation(fields: [recordId], references: [id])

  // ── Ingestion offline (cœur offline-licensing) — toutes NULLABLES ─────────
  // Le clair (objectKey ci-dessus) est CONSERVÉ pour la lecture en ligne
  // (pdf.js). En parallèle, un blob AEAD segmenté (16 Ko) est produit pour la
  // lecture offline. La CEK (clé de contenu) N'EST JAMAIS stockée en clair :
  // encWrappedCek = CEK enveloppée par la KEK serveur (AES-256-GCM). encStatus
  // pilote l'idempotence de la (ré)ingestion : "pending" | "ready" | "failed".
  encObjectKey    String?   @map("enc_object_key") // blob chiffré dans MinIO
  encWrappedCek   String?   @map("enc_wrapped_cek") // CEK wrappée par la KEK (base64), jamais en clair
  encSegSize      Int?      @map("enc_seg_size") // taille de segment AEAD (octets)
  encAlgo         String?   @map("enc_algo") // marqueur de format, ex. "aead-seg-gcm-16k/v1"
  encStatus       String?   @map("enc_status") // pending | ready | failed
  encError        String?   @map("enc_error") // dernier message d'échec d'ingestion
  xrefValidatedAt DateTime? @map("xref_validated_at")
  encryptedAt     DateTime? @map("encrypted_at")

  @@map("digital_copies")
}

enum DigitalFormat {
  PDF
  EPUB
}

// ── Cœur offline (module offline-licensing) ──────────────────────────────
// Modèles PAR-TENANT (câblés dans tenancy/tenant-schema.ts : TENANT_TABLES +
// TENANT_FOREIGN_KEYS). Statuts en TEXTE (JAMAIS d'enum) et colonnes nullables :
// le sync-schema crée ces tables sur les écoles déjà provisionnées sans casser
// les lignes existantes (un enum/NOT NULL sans défaut le casserait).

// Appareil enregistré d'un lecteur. Porte la clé PUBLIQUE servant à envelopper
// la CEK ; la clé privée reste non-exportable dans l'Android Keystore de
// l'appareil et n'est jamais transmise au serveur.
model Device {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  label     String? // libellé lisible (ex. modèle du téléphone)
  publicKey String           @map("public_key") // clé publique appareil (SPKI base64) pour envelopper la CEK
  platform  String? // "android" (iOS = v2)
  createdAt DateTime         @default(now()) @map("created_at")
  revokedAt DateTime?        @map("revoked_at") // appareil désenregistré / bloqué
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenses  OfflineLicense[]

  @@index([userId])
  @@map("devices")
}

// Bail offline signé pour un triplet (document, utilisateur, appareil). `status`
// en TEXTE : "active" | "revoked" | "expired". La signature Ed25519 (clé privée
// serveur, hors dépôt) est vérifiée par l'app avant tout rendu.
model OfflineLicense {
  id         String       @id @default(uuid())
  recordId   String       @map("record_id") // le document (notice) = "docId" côté mobile
  userId     String       @map("user_id")
  deviceId   String       @map("device_id")
  status     String       @default("active") // TEXTE, pas d'enum
  issuedAt   DateTime     @default(now()) @map("issued_at")
  expiresAt  DateTime     @map("expires_at") // borne du bail (TTL tenant, défaut 14 j)
  wrappedCek String       @map("wrapped_cek") // CEK enveloppée pour la clé publique appareil (RSA-OAEP)
  rights     Json? // { watermark, noPrint, ... }
  signature  String // signature Ed25519 du corps de licence
  revokedAt  DateTime?    @map("revoked_at")
  record     BiblioRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // UNE licence par (utilisateur, appareil, document). Sans cette contrainte,
  // chaque appui sur « télécharger » créait une licence de plus : révoquer
  // « la » licence n'en révoquait qu'une, les autres restaient actives et le
  // blob restait téléchargeable. L'administrateur croyait l'accès coupé.
  // Vérifié en conditions réelles : 7 licences pour un même document.
  // `map:` fige le nom RÉELLEMENT déployé. Prisma nommerait cet index
  // `..._key` ; l'historique de migrations et `buildUniqueIndexStatements`
  // (rattrapage tenant) le créent en `..._idx`. On aligne le modèle sur ce qui
  // existe plutôt que de renommer un index vivant dans chaque schéma — un
  // renommage cosmétique qui désynchroniserait le rattrapage tenant.
  @@unique([userId, deviceId, recordId], map: "offline_licenses_user_id_device_id_record_id_idx")
  @@index([userId])
  @@index([deviceId])
  @@index([recordId])
  @@map("offline_licenses")
}

model Item {
  id         String       @id @default(uuid())
  recordId   String       @map("record_id")
  barcode    String       @unique
  callNumber String?      @map("call_number")
  location   String?
  status     ItemStatus   @default(AVAILABLE)
  itemType   String?      @map("item_type")
  record     BiblioRecord @relation(fields: [recordId], references: [id])
  checkouts  Checkout[]

  // Jointures notice→exemplaires (fiche notice, disponibilité OPAC, placeHold)
  // et filtres where: { recordId } — la FK n'est pas indexée automatiquement.
  @@index([recordId])
  @@map("items")
}

// Format NATIF d'une notice (colonne `biblio_records.marc_format`).
//
// GAFESO n'est pas un dialecte MARC : c'est la « notice Gafeso », le modèle
// plat propriétaire de l'application (voir docs/architecture-notice.md). Une
// notice saisie dans Gafeso n'a jamais eu de MARC ; la déclarer UNIMARC avec
// un `marcData` vide était une affirmation fausse portée par le schéma.
// Le nom de la colonne reste `marc_format` pour l'instant (renommage en
// `source_format` au backlog) — la valeur, elle, dit maintenant la vérité.
// Formats de DESCRIPTION, pas seulement MARC — malgré le nom du type, qui
// attend son renommage (`DescriptionFormat`, au backlog : il touche chaque
// schéma tenant).
//
// ⚠ C'est ce vocabulaire qui rendait la couche 3 incomplète : il ne savait
// NOMMER que du MARC. Une description Dublin Core pouvait être stockée dans
// `marcData` sans pouvoir être déclarée — ce qui vide I3 de son sens, puisque
// « ce qui arrive dans un format y reste » suppose de pouvoir dire lequel.
//
// GAFESO         : décrite nativement dans Gafeso, aucune source externe.
// MARC21/UNIMARC : reçue par import ou moissonnage MARC.
// DUBLIN_CORE    : reçue en Dublin Core. ⚠ Aucun chemin ne la PRODUIT encore —
//   le client de moissonnage OAI est en P7. Posée maintenant parce qu'étendre ce
//   type est une opération MULTI-ÉTABLISSEMENTS (type par schéma, voir la
//   migration) : la poser le jour où le besoin arrive coûterait le même
//   balayage, en urgence. C'est un vocabulaire, pas une commande inerte.
enum MarcFormat {
  MARC21
  UNIMARC
  GAFESO
  DUBLIN_CORE
}

enum ItemStatus {
  AVAILABLE
  CHECKED_OUT
  ON_HOLD
  IN_TRANSIT
  DAMAGED
  LOST
  WITHDRAWN
  // Introuvable à l'issue d'un récolement (inventaire) — statut dédié posé par
  // l'action « marquer les manquants » à la clôture d'une session.
  MISSING
}

// ── Circulation ──

model Checkout {
  id           String    @id @default(uuid())
  itemId       String    @map("item_id")
  patronId     String    @map("patron_id")
  checkoutDate DateTime  @default(now()) @map("checkout_date")
  dueDate      DateTime  @map("due_date")
  returnDate   DateTime? @map("return_date")
  /// COMMENT le prêt s'est terminé : `rendu` | `perte`. NULL tant qu'il est
  /// OUVERT — et seulement là, la migration ayant rempli `rendu` sur tout
  /// l'historique clos (le retour était le seul chemin de clôture).
  ///
  /// ⚠ TEXTE ET NON ENUM, comme `deposits.status` et `deposits.file_format` :
  /// un type enum doit être RECRÉÉ dans chaque schéma tenant, et le rattrapage
  /// de colonnes de `sync-schema` EXCLUT justement les colonnes enum. Une école
  /// existante ne recevrait donc jamais celle-ci par le chemin normal.
  ///
  /// ⚠ POURQUOI ELLE EXISTE. Le seul chemin qui clôturait un prêt était le
  /// RETOUR. Pour un document perdu, la bibliothécaire devait donc déclarer un
  /// retour qui n'avait pas eu lieu — et ce chemin remet l'exemplaire en
  /// `AVAILABLE`, ou pire le met `ON_HOLD` et prévient le lecteur suivant que
  /// son document l'attend au guichet. Pour un livre que personne n'a.
  closedAs     String?   @map("closed_as")
  renewals     Int       @default(0)
  fineAmount   Int       @default(0) @map("fine_amount")
  item         Item      @relation(fields: [itemId], references: [id])
  patron       Patron    @relation(fields: [patronId], references: [id])

  @@index([patronId])
  @@index([dueDate])
  // Retour par code-barres et comptages « prêts en cours d'un adhérent »
  // (returnDate IS NULL) — voir circulation.service (checkout/situation).
  @@index([patronId, returnDate])
  // Séries temporelles du tableau de bord (stats.service) : prêts groupés par
  // date de prêt, retours par date de retour (date_trunc sur période).
  @@index([checkoutDate])
  @@index([returnDate])
  @@map("checkouts")
}

model Hold {
  id         String       @id @default(uuid())
  recordId   String       @map("record_id")
  patronId   String       @map("patron_id")
  status     HoldStatus   @default(PENDING)
  priority   Int          @default(0)
  expiryDate DateTime?    @map("expiry_date")
  // Idempotence de l'email « réservation disponible » : posé au moment de l'envoi.
  // NULLable (table tenant) → le rattrapage sync-schema l'ajoute sans défaut.
  notifiedAt DateTime?    @map("notified_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  record     BiblioRecord @relation(fields: [recordId], references: [id])
  patron     Patron       @relation(fields: [patronId], references: [id])

  // Table interrogée ~16× dans circulation.service, presque toujours par
  // (recordId, status) — file d'attente d'une notice — ou par patronId.
  @@index([recordId, status])
  @@index([patronId])
  @@map("holds")
}

// ── Récolement / inventaire (vague 2) ──
// Sessions d'inventaire persistées (un récolement réel dure des jours →
// interruptible et reprenable). Tables TENANT → propagation par sync-schema.
// scope/status/result en TEXTE (pas d'enum Postgres) : évite la douleur de
// propagation des enums tenant (parti pris déjà retenu pour les rôles de
// contributeur).
model InventorySession {
  id        String          @id @default(uuid())
  name      String
  scope     String          @default("ALL") // ALL | LOCATION
  location  String? // localisation ciblée si scope = LOCATION
  /// `OPEN` | `CLOSED` | `APPLIED`.
  ///
  /// ⚠ `APPLIED` EXISTE POUR QUE « ROUVRIR » PUISSE REFUSER. Une session dont
  /// on a marqué les manquants a CHANGÉ LE CATALOGUE — des exemplaires sont
  /// passés en `MISSING`. La rouvrir et rescanner produirait un second
  /// marquage sur un fonds déjà modifié. Tant que rien n'est appliqué, une
  /// clôture prématurée n'est qu'une erreur de clic, et refaire des jours de
  /// scan pour ça serait absurde.
  ///
  /// TEXTE et non enum : c'est la convention des tables tenant, et le
  /// rattrapage `sync-schema` EXCLUT les colonnes enum.
  status    String          @default("OPEN")
  createdBy String?         @map("created_by") // email de l'agent (trace)
  createdAt DateTime        @default(now()) @map("created_at")
  closedAt  DateTime?       @map("closed_at")
  scans     InventoryScan[]

  @@map("inventory_sessions")
}

model InventoryScan {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  barcode   String
  // Exemplaire résolu (null si code-barres inconnu). Pas de FK : un exemplaire
  // supprimé ne doit pas effacer l'historique de scan.
  itemId    String?          @map("item_id")
  result    String // SEEN | ON_LOAN | UNKNOWN | OUT_OF_SCOPE
  scannedAt DateTime         @default(now()) @map("scanned_at")
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Un code-barres n'est compté qu'une fois par session (re-scan → « déjà vu »).
  @@unique([sessionId, barcode])
  @@index([sessionId])
  @@map("inventory_scans")
}

model CirculationRule {
  id             String @id @default(uuid())
  patronCategory String @map("patron_category")
  itemType       String @map("item_type")
  loanPeriodDays Int    @map("loan_period_days")
  maxRenewals    Int    @default(1) @map("max_renewals")
  maxCheckouts   Int    @default(5) @map("max_checkouts")
  finePerDay     Int    @default(0) @map("fine_per_day")

  @@unique([patronCategory, itemType])
  @@map("circulation_rules")
}

enum HoldStatus {
  PENDING
  AVAILABLE
  FULFILLED
  CANCELLED
  EXPIRED
}

// ── Patrons ──

// Un ADHÉRENT est une PERSONNE inscrite à la bibliothèque, pas un compte
// applicatif. Une carte se délivre à un lecteur sans adresse e-mail, à un
// visiteur extérieur, à un élève trop jeune pour un compte — exiger un compte
// pour porter un nom reviendrait à exiger une identité numérique pour emprunter
// un livre.
//
// D'où `firstName` / `lastName` PORTÉS ICI, et non seulement sur le compte lié.
// NULLABLES : les cartes déjà créées n'en ont pas, et la contrainte se pose
// dans le DTO (un nom OU un compte lié), pas dans la colonne.
//
// ⚠ QUAND UN COMPTE EST LIÉ, C'EST LE NOM DE L'ADHÉRENT QUI FAIT FOI, et la
// raison n'est pas esthétique : corriger le nom d'un COMPTE exige
// `comptes.gerer`, que seul l'Administrateur détient. Si le compte faisait foi,
// un nom mal orthographié serait incorrigible par la bibliothécaire, qui porte
// `adherents.gerer`. Le nom est recopié depuis le compte au moment du lien,
// puis il lui appartient.
model Patron {
  id               String     @id @default(uuid())
  userId           String?    @unique @map("user_id")
  firstName        String?    @map("first_name")
  lastName         String?    @map("last_name")
  barcode          String     @unique
  category         String
  registrationDate DateTime   @default(now()) @map("registration_date")
  expiryDate       DateTime?  @map("expiry_date")
  user             User?      @relation(fields: [userId], references: [id])
  checkouts        Checkout[]
  holds            Hold[]

  @@map("patrons")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOISSONNAGE OAI-PMH (P7-1) — Gafeso apprend à RECEVOIR
// ═══════════════════════════════════════════════════════════════════════════
//
// L'entrepôt OAI de P4-3 EXPOSE ; ces trois tables gouvernent l'ENTRÉE. Elles
// sont tenant-scopées : une école déclare SES sources.
//
// ⚠ SIX ARBITRAGES DU BRIEF Y SONT INSCRITS, pas seulement commentés :
//  · ce qui arrive par moissonnage reste marqué comme tel (HarvestedRecord) ;
//  · le moissonnage ne modifie jamais une notice locale — il SIGNALE
//    (`status = 'collision'`) ;
//  · aucune suppression automatique (`status = 'supprimee_a_la_source'`) ;
//  · `BiblioRecord.id` reste la clé interne — I1, ce lien le POINTE.

/// UNE SOURCE DÉCLARÉE — l'entrepôt distant qu'on vient chercher.
model HarvestSource {
  id   String @id @default(uuid())
  /// Un nom lisible : une URL n'est pas un nom dans une liste.
  name String

  /// ⚠ CES TROIS CHAMPS SONT LE CONTRAT DU CLIENT PUR (`SourceOai` dans
  /// `moissonnage/client-oai.ts`), PAS UN VOCABULAIRE NEUF. Les renommer ici
  /// créerait deux vocabulaires pour une même chose — et deux vocabulaires
  /// qui s'accordent aujourd'hui s'accordent par coïncidence.
  baseUrl        String @map("base_url")
  /// `oai_dc`, `marcxml`, `etdms`…
  metadataPrefix String @map("metadata_prefix")

  /// L'ensemble à moissonner. ⚠ `""` VEUT DIRE « TOUT L'ENTREPÔT », et la
  /// colonne est NON NULLE À DESSEIN.
  ///
  /// En PostgreSQL, un index unique composite NE DÉDUPLIQUE PAS les lignes où
  /// l'une des colonnes est NULL : deux sources visant le même entrepôt sans
  /// ensemble auraient donc passé la contrainte ci-dessous sans qu'elle dise
  /// rien. Une contrainte qui ne contraint pas est un faux silencieux, et
  /// celui-ci ne se voit qu'au premier doublon moissonné.
  ///
  /// Le service convertit `""` en `undefined` au bord, pour que le client pur
  /// garde son `set?: string` — l'absence est honnête à l'API, la chaîne vide
  /// est ce que la contrainte sait comparer.
  setSpec String @default("") @map("set_spec")

  /// `manuelle` | `quotidienne` | `hebdomadaire`. TEXTE et non enum :
  /// `sync-schema` EXCLUT les colonnes enum du rattrapage, une école existante
  /// ne la recevrait jamais.
  periodicity String  @default("manuelle")
  active      Boolean @default(true)

  /// ⚠ LE CURSEUR INCRÉMENTAL, EN TEXTE — PAS EN DateTime. OAI-PMH admet deux
  /// granularités (`2026-09-12` et `2026-09-12T18:04:00Z`) ; l'entrepôt impose
  /// la sienne, et il faut lui REDONNER ce qu'il comprend. Le normaliser en
  /// DateTime lui renverrait une granularité qu'il n'a jamais employée, sur le
  /// paramètre même qui décide de ce qu'on reçoit. C'est I3 sous une autre
  /// forme : ce qui arrive dans un format y reste.
  ///
  /// ⚠ Il n'avance QU'À LA FIN d'une exécution aboutie — voir `HarvestRun`.
  lastDatestamp String? @map("last_datestamp")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  runs      HarvestRun[]
  moissonnees HarvestedRecord[]

  /// ⚠ PAS `baseUrl` SEULE : viser le même entrepôt avec deux ensembles
  /// différents est l'usage normal — une faculté, puis une autre.
  @@unique([baseUrl, metadataPrefix, setSpec])
  @@map("harvest_sources")
}

/// UNE EXÉCUTION — un compte rendu par passage, et il dit les trois états.
model HarvestRun {
  id       String        @id @default(uuid())
  sourceId String        @map("source_id")
  source   HarvestSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime?                 @map("finished_at")

  /// `en_cours` | `moisson` | `vide` | `injoignable` | `erreur_protocole` —
  /// les quatre issues du client pur, plus l'état courant.
  ///
  /// ⚠ UNE SOURCE INJOIGNABLE N'EST PAS UNE SOURCE VIDE. Les confondre ferait
  /// lire « zéro notice » là où il faut lire « je n'ai pas pu savoir », et
  /// c'est ce que le brief demande explicitement.
  outcome String  @default("en_cours")
  /// Le motif, quand ce n'est ni `moisson` ni `vide`.
  reason  String?

  received  Int @default(0)
  created   Int @default(0)
  ignored   Int @default(0)
  collided  Int @default(0)
  /// Signalées PAR LA SOURCE, jamais appliquées — décision 6.
  deletions Int @default(0)
  pages     Int @default(0)

  /// ⚠ LE JETON DE REPRISE EST PÉRISSABLE. Un `resumptionToken` expire, souvent
  /// en minutes. Le garder pour « reprendre demain » serait une promesse qu'on
  /// ne peut pas tenir : on garde donc AUSSI sa date limite, et au-delà on
  /// repart du `lastDatestamp` de la source. Sans `resumptionExpires`, la
  /// reprise échouerait d'une manière qui ressemble à une source cassée.
  resumptionToken   String?   @map("resumption_token")
  resumptionExpires DateTime? @map("resumption_expires")

  /// Le dernier `datestamp` vu pendant CETTE exécution.
  ///
  /// ⚠ IL NE REMONTE DANS LA SOURCE QU'À L'ABOUTISSEMENT. Faire avancer le
  /// curseur en cours de route ferait sauter les notices d'une page jamais
  /// reçue — et la perte serait définitive, puisqu'on ne redemanderait plus
  /// jamais cette fenêtre.
  lastDatestamp String? @map("last_datestamp")

  @@index([sourceId, startedAt])
  @@map("harvest_runs")
}

/// L'IDENTITÉ D'UNE NOTICE MOISSONNÉE — ce qui rend le moissonnage REJOUABLE.
model HarvestedRecord {
  id       String @id @default(uuid())
  sourceId String @map("source_id")
  /// ⚠ LA RELATION VERS LA SOURCE EST DÉCLARÉE, celle vers la NOTICE ne l'est
  /// pas — et la différence n'est pas un oubli. La clé étrangère
  /// `source_id → harvest_sources(id)` existe en base depuis la migration, avec
  /// CASCADE : la mémoire d'un moissonnage n'a aucun sens sans sa source. La
  /// déclarer ici ne change donc rien au schéma, elle rend seulement la
  /// jointure disponible au client — ce que la fédération (P7-3) demande pour
  /// nommer l'école d'origine sans une seconde requête par notice.
  source   HarvestSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// L'identifiant OAI de la source. ⚠ C'est SA clé, jamais la nôtre — et
  /// c'est elle qui empêche un second moissonnage de tout dupliquer.
  oaiIdentifier String @map("oai_identifier")
  datestamp     String

  /// La notice locale, si elle a été créée ; NULL quand on a refusé d'écrire.
  /// ⚠ `BiblioRecord.id` NE CHANGE JAMAIS (I1) : ce lien le POINTE, il ne le
  /// remplace pas. Pas de relation déclarée — une clé étrangère ferait
  /// dépendre la mémoire du moissonnage de la survie de la notice.
  recordId String? @map("record_id")

  /// `importee` | `collision` | `ignoree` | `supprimee_a_la_source`
  ///
  /// ⚠ `supprimee_a_la_source` EST LA DÉCISION 6 RENDUE VISIBLE : la notice
  /// locale n'est PAS effacée, on note seulement que la source ne la donne
  /// plus. Un moissonneur qui supprime sur absence transforme une panne de la
  /// source en perte de données.
  ///
  /// ⚠ `collision` EST LA DÉCISION 2 : on signale, on ne tranche pas. Rien
  /// n'est écrasé, et la collision se lit — c'est l'écran de P7-4.
  status String

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt      @map("last_seen_at")

  @@unique([sourceId, oaiIdentifier])
  @@index([status])
  @@map("harvested_records")
}
