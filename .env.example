# Nom de projet Compose : préfixe volumes/réseau/images.
# Un poste de dev DÉJÀ en place doit garder sa valeur historique
# (bibliocloud) sous peine de détacher ses volumes — ne changez cette
# ligne que sur un clone neuf.
COMPOSE_PROJECT_NAME=gafeso

# ─────────────────────────────────────────────────────────────
# Gafeso — Variables d'environnement (exemple)
# Copier vers .env : cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Application ──
NODE_ENV=development
API_PORT=4000
# URL du frontend (base des liens envoyés par email, ex. définir mot de passe)
APP_URL=http://localhost:3000
# Origines autorisées CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# ── Base de données (PostgreSQL 16) ──
POSTGRES_USER=gafeso
POSTGRES_PASSWORD=gafeso_dev
POSTGRES_DB=gafeso
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gafeso:gafeso_dev@localhost:5432/gafeso?schema=public

# ── Authentification (JWT) ──
JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_EXPIRES_IN=1d

# ── Plateforme / super-admin (provisioning des écoles) ──
# Clé requise dans l'en-tête x-admin-api-key pour les routes /admin/*
ADMIN_API_KEY=change_me_admin_api_key

# ── Redis (cache / BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Moteur de recherche ──
# Quel moteur indexe et sert l'OPAC ? Deux choix, bascule par CONFIG (pas de
# code) :
#   meilisearch   → défaut RECOMMANDÉ, ~100 Mo de RAM, zéro réglage.
#   elasticsearch → option « infra existante », 2–4 Go de RAM (voir
#                   docs/search-engines.md). N'activez ES que si vous réutilisez
#                   un Elasticsearch déjà en place.
# Absent ou inconnu → repli sûr sur Meilisearch. Après avoir basculé : réindexer
# chaque école (voir DEPLOY.md).
SEARCH_ENGINE=meilisearch

# Meilisearch (utilisé si SEARCH_ENGINE=meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=meili_dev_master_key
MEILI_PORT=7700

# Elasticsearch (utilisé UNIQUEMENT si SEARCH_ENGINE=elasticsearch).
# Service Docker en profil dédié : docker compose --profile elasticsearch up -d
# ELASTIC_NODE=http://localhost:9200
# ELASTIC_USERNAME=        # si xpack.security activé (prod)
# ELASTIC_PASSWORD=
# ELASTIC_PORT=9200

# ── Email (SMTP) ──
# SMTP_HOST absent = mode dev : les emails sont journalisés au lieu d'être envoyés.
# En dev local, Mailpit (docker) : SMTP sur 1025, interface web sur http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# Vide = DÉDUIT DU PORT (465 → TLS implicite ; 587/25 → STARTTLS). C'est le
# bon réglage dans la quasi-totalité des cas. Ne forcez true/false que pour
# un serveur exotique : « true » sur le port 587 fait échouer la poignée de
# main, et aucun mail ne part alors que le port répond.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gafeso <no-reply@gafeso.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── MinIO (stockage S3) ──
MINIO_ROOT_USER=gafeso
MINIO_ROOT_PASSWORD=gafeso_dev
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=gafeso

# ── Cœur offline (module offline-licensing) — SECRETS, hors dépôt ──
# Le serveur REFUSE de démarrer si ces clés sont absentes/malformées.
# 1) KEK de contenu : enveloppe les CEK au repos (AES-256-GCM). 32 octets, base64.
#    Générer :  openssl rand -base64 32
OFFLINE_CONTENT_KEK=
# 2) Clé privée de signature de licence (Ed25519, PEM PKCS8). Le serveur signe,
#    l'app mobile vérifie avec la clé publique embarquée. NE JAMAIS COMMITER.
#    Générer :  openssl genpkey -algorithm ed25519 -out ed25519.pem
#    puis coller le PEM sur une ligne (retours à la ligne échappés \n).
OFFLINE_LICENSE_PRIVATE_KEY=
