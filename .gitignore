# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Env
.env
.env.prod
.env.local
.env.*.local
*.env.backup*

# Installateur : réponses locales (peut contenir des infos d'établissement) et
# sauvegardes générées. install.conf.example, lui, est versionné.
install.conf
/backups/

# Prisma
apps/api/prisma/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / tests
coverage/
.nyc_output/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Docker volumes (local overrides)
docker/data/

# Ressources pdf.js copiées depuis node_modules (scripts/copy-pdfjs-assets.mjs)
apps/web/public/pdfjs/

# Fonds numérisé réel (thèses/mémoires d'un établissement, ~12 Go, DONNÉES PERSONNELLES) —
# jamais commité. Sert de source aux tests/ingestion locale uniquement.
docs/documentsnumerises/

# Dumps de base (peuvent contenir des données réelles) — jamais versionnés.
*.dump
*.sql.gz

# Documents de travail INTERNES (audits, maquettes, cahiers des charges, briefs de conception).
# La doc publique reste versionnée (README, INSTALL, DEPLOY, docs/ orientée utilisateur).
docs/audit/
docs/maquettes/
docs/cahier-des-charges-*.md
brief-*.md
amendement-*.md
spike-*.md
reconciliation-*.md

# Documents internes ou concernant des tiers, jamais versionnés : ce dépôt sert
# de source à un instantané public. Un `git add -A` distrait a déjà versionné le
# guide d'audit DSI ONTU-BF — rattrapé avant publication, mais une seule fois
# suffit. Les extensions bureautiques sont donc exclues par défaut.
*.docx
*.doc
*.xlsx
*.pptx
